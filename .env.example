# Copy to .env.local and fill in. Never commit the filled-in copy — .env.local
# is gitignored, and the values below are the only things that must not be
# published.
#
# NOTE: this file used to document ADMIN_TOKEN. That variable is gone. Admin
# access is now a signed session cookie backed by ADMIN_PASSWORD and
# ADMIN_SESSION_SECRET, and setting neither disables sign-in rather than
# leaving the routes open. See lib/auth.ts and middleware.ts.

# --- Supabase: the intelligence store ---------------------------------------
# The publishable key is safe in the browser. It can only read the rows that RLS
# exposes to anon, and the stored procedures that write are revoked from anon.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# The secret key bypasses RLS and is therefore server-only.
#
# Two consumers, and they are separate:
#   1. The sweep Edge Function reads it from Supabase Vault, not from here.
#      See supabase/vault.sql. pg_net presents it as the `apikey` header.
#   2. lib/admin-db.ts reads it from THIS variable, and is imported only by
#      /admin and /discovery. Those routes are gated in middleware.
#
# If /admin reports "no server-side database credential is configured", this is
# the variable that is missing.
# SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# --- Admin (A80) ------------------------------------------------------------
# Both are required. With either unset, sign-in refuses and the internal routes
# stay closed — they do not fall open.
#
# ADMIN_PASSWORD   the password an admin types. Compared in constant time.
# ADMIN_SESSION_SECRET  the HMAC key that signs the session cookie. A long
#                      random string; changing it invalidates existing sessions.
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ADMIN_PASSWORD=replace_me
# ADMIN_SESSION_SECRET=replace_me_with_64_hex_chars

# --- Frontend ---------------------------------------------------------------
# Absolute base used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=https://free-pool-radar.vercel.app
