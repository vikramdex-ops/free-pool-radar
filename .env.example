# Copy to .env.local and fill in. Never commit the filled-in copy.

# --- Supabase: the intelligence store ---------------------------------------
# The publishable key is safe in the browser. It can only read the rows that RLS
# exposes to anon, and the stored procedures that write are revoked from anon.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# The secret key bypasses RLS and is therefore server-only. It is used by the
# sweep Edge Function, which Supabase injects automatically, so you do not
# normally need to set it here. Set it only if you run the sweep from Node.
# SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# --- Admin ------------------------------------------------------------------
# Protects /admin and /discovery. Generate with: openssl rand -hex 32
# Leave unset locally to keep those routes readable during development; the
# route refuses to render in production without one.
# ADMIN_TOKEN=replace_me

# --- Frontend ---------------------------------------------------------------
# Absolute base used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=https://free-pool-radar.vercel.app
